# ============================================================
# THE SWITCH.
#
#   false -> services run exactly as written. Zero telemetry.
#   true  -> `opentelemetry-instrument` wraps them. Full traces,
#            metrics and logs, with no application code change.
#
# Flip this, `docker compose up -d --force-recreate`, and watch
# the collector logs. That contrast IS the Phase 0 lesson.
# ============================================================
OTEL_ENABLED=true

# Traffic rate from loadgen (requests/sec)
LOADGEN_RPS=5

# ---- Phase 6 chaos knobs (all neutral by default) ----
PAYMENTS_LATENCY_MS=40
PAYMENTS_FAILURE_RATE=0.0
PAYMENTS_DECLINE_RATE=0.02
INVENTORY_SLOW_QUERY_MS=0
INVENTORY_POOL_SIZE=10
ORDERS_POOL_SIZE=10

# Phase 2: set to true to label business metrics by customer_id and watch the
# series count explode by ~500x. Set back to false afterwards.
ORDERS_CARDINALITY_DEMO=false
INVENTORY_CACHE_TTL_S=10
PAYMENTS_LATENCY_JITTER_MS=30
ORDERS_RETRY_ATTEMPTS=0
ORDERS_RETRY_BACKOFF_MS=0
ORDERS_LEAK_KB=0
ORDERS_UPSTREAM_TIMEOUT_S=5
GATEWAY_UPSTREAM_TIMEOUT_S=10
