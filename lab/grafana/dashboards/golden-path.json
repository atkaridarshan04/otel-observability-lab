{
  "uid": "golden-path",
  "title": "Golden path \u2014 alert to log line",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "1. The symptom \u2014 what the user feels",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Checkout error rate (5xx) \u2014 the only thing worth paging on",
      "description": "Symptom-based: the fraction of user requests that failed. Not CPU, not memory, not queue depth \u2014 what the user actually experienced.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"shop/gateway\",http_status_code=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_duration_milliseconds_count{job=\"shop/gateway\"}[1m])), 0.001)",
          "legendFormat": "error ratio",
          "editorMode": "code",
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout latency p99 \u2014 click an exemplar to start the drill-down",
      "description": "STEP 2 of the golden path. Each dot is a real request. Click one and Grafana opens its trace in Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{job=\"shop/gateway\"}[1m])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true,
          "exemplar": true
        }
      ]
    },
    {
      "type": "row",
      "title": "2. Narrowing \u2014 which service, which dependency",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "p95 by service \u2014 who is actually slow?",
      "description": "The gateway being slow usually means something downstream is slow. This panel names it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx by service",
      "description": "Errors propagate upward, so the service with the EARLIEST rise is usually the cause, not the one with the most errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "type": "row",
      "title": "3. The evidence \u2014 the actual log lines",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "logs",
      "title": "Errors across all services \u2014 expand a line for its trace link",
      "description": "STEP 5, the end of the golden path. These lines carry trace_id, order_id and customer_id as structured fields, so you can filter on any of them rather than grepping.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_namespace=\"shop\"} | severity_text=\"ERROR\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}